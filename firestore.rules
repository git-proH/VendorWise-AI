rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidVendor(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.monthlySpend is number && data.monthlySpend >= 0 &&
             data.status in ['active', 'inactive', 'underutilized'] &&
             data.ownerId == request.auth.uid;
    }

    function isValidRecommendation(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.projectedSavings is number && data.projectedSavings >= 0 &&
             data.status in ['pending', 'applied', 'dismissed'] &&
             data.ownerId == request.auth.uid;
    }

    function isValidInvoice(data) {
      return data.amount is number && data.amount >= 0 &&
             data.date is string &&
             data.status in ['paid', 'pending', 'flagged'] &&
             data.ownerId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /vendors/{vendorId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidVendor(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidVendor(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /recommendations/{recId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidRecommendation(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidRecommendation(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /invoices/{invId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidInvoice(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidInvoice(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }
  }
}
